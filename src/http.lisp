(in-package :mend)

(define-condition http-problem (error)
  ((code :initarg :code :reader problem-code) (message :initarg :message :reader problem-message)))
(defun reject (code message) (error 'http-problem :code code :message message))
(defun socket-byte (stream)
  (when (eq :eof (socket:socket-status (cons stream :input) 5)) (error "Connection closed."))
  (unless (listen stream)
    (unless (socket:socket-status (cons stream :input) 5) (reject 408 "Request timed out.")))
  (read-byte stream))
(defun http-line (stream)
  (with-output-to-string (out)
    (loop for count from 0 for byte = (socket-byte stream) until (= byte 10) do
      (when (> count 8192) (reject 413 "Request headers are too large."))
      (unless (= byte 13) (write-char (code-char byte) out)))))
(defun respond (stream code body &optional (type "application/json; charset=utf-8"))
  (let* ((bytes (utf8 body))
         (reason (or (cdr (assoc code '((200 . "OK") (201 . "Created") (400 . "Bad Request")
                      (403 . "Forbidden") (404 . "Not Found") (405 . "Method Not Allowed")
                      (408 . "Request Timeout") (413 . "Content Too Large") (422 . "Unprocessable Content") (500 . "Internal Server Error")))) "Error"))
         (headers (format nil "HTTP/1.1 ~D ~A~C~CContent-Type: ~A~C~CContent-Length: ~D~C~CConnection: close~C~CCache-Control: no-store~C~CX-Content-Type-Options: nosniff~C~CReferrer-Policy: same-origin~C~CContent-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'~C~C~C~C"
           code reason #\Return #\Newline type #\Return #\Newline (length bytes) #\Return #\Newline
           #\Return #\Newline #\Return #\Newline #\Return #\Newline #\Return #\Newline #\Return #\Newline #\Return #\Newline)))
    (write-sequence (utf8 headers) stream) (write-sequence bytes stream) (finish-output stream)))
(defun handle-api (stream method path headers body)
  (cond
    ((and (equal path "/api/requests") (equal method "GET")) (respond stream 200 (requests-json)))
    ((equal method "POST")
     (unless (equal (cdr (assoc "x-csrf-token" headers :test #'equal)) *csrf-token*) (reject 403 "Refresh the page and try again."))
     (let* ((parts (split path #\/)) (id (and (= (length parts) 4) (positive-id (fourth parts))))
            (delete-id (and (= (length parts) 5) (equal (fifth parts) "delete") (positive-id (fourth parts))))
            (create (equal path "/api/requests")))
       (unless (or create id delete-id) (reject 404 "Endpoint not found."))
       (unless (or create (request-exists-p (or id delete-id))) (reject 404 "This request no longer exists. Refresh the list."))
       (if delete-id
         (progn (delete-request delete-id) (respond stream 200 (json-object "message" "Request deleted.")))
         (progn
           (unless (search "application/x-www-form-urlencoded" (or (cdr (assoc "content-type" headers :test #'equal)) ""))
             (reject 400 "Use a URL-encoded form."))
           (let* ((form (parse-form body)) (errors (validate-request form)))
             (if errors
               (respond stream 422 (format nil "{\"message\":\"Please check the highlighted fields.\",\"errors\":~A}"
                                      (apply #'json-object (loop for (k . v) in errors append (list k v)))))
               (progn (save-request form id) (respond stream (if create 201 200)
                 (json-object "message" (if create "Request created." "Request updated."))))))))))
    (t (reject 405 "Method not allowed."))))
(defun handle-client (stream)
  (handler-case
    (let* ((line (split (http-line stream) #\Space)) (method (first line))
           (path (first (split (or (second line) "") #\?)))
           (headers (loop for count from 0 for line = (http-line stream) until (equal line "")
                     collect (let ((colon (position #\: line)))
                       (unless (and colon (< count 60)) (reject 400 "Invalid headers."))
                       (cons (string-downcase (subseq line 0 colon)) (string-trim '(#\Space) (subseq line (1+ colon)))))))
           (host (cdr (assoc "host" headers :test #'equal)))
           (origin (cdr (assoc "origin" headers :test #'equal)))
           (length-text (or (cdr (assoc "content-length" headers :test #'equal)) "0")))
      (unless (member host (list (format nil "localhost:~D" *port*) (format nil "127.0.0.1:~D" *port*)) :test #'equal)
        (reject 403 "Use the local app address."))
      (when (and origin (not (equal origin (concatenate 'string "http://" host)))) (reject 403 "Origin is not allowed."))
      (when (assoc "transfer-encoding" headers :test #'equal) (reject 400 "Transfer encoding is not supported."))
      (unless (and (<= 1 (length length-text) 6) (every #'digit-char-p length-text)) (reject 400 "Invalid content length."))
      (let* ((size (parse-integer length-text)) (body ""))
        (when (> size 32768) (reject 413 "The request is too large."))
        (when (plusp size)
          (setf body (map 'string #'code-char (loop repeat size collect (socket-byte stream)))))
        (cond
          ((or (equal path "/api/requests") (search "/api/requests/" path :end2 (min (length path) 14)))
            (handle-api stream method path headers body))
          ((equal method "GET")
            (let ((file (cdr (assoc path '(("/" . "public/index.html") ("/app.css" . "public/app.css")
                         ("/app.js" . "public/app.js") ("/favicon.svg" . "public/favicon.svg")) :test #'equal))))
              (unless file (reject 404 "Page not found."))
              (respond stream 200 (read-text (merge-pathnames file *root*))
                (cond ((equal path "/app.css") "text/css; charset=utf-8")
                      ((equal path "/app.js") "text/javascript; charset=utf-8")
                      ((equal path "/favicon.svg") "image/svg+xml") (t "text/html; charset=utf-8")))))
          (t (reject 405 "Method not allowed.")))))
    (http-problem (e) (ignore-errors (respond stream (problem-code e) (json-object "message" (problem-message e)))))
    (error (e) (format *error-output* "~&Request error: ~A~%" e)
      (ignore-errors (respond stream 500 (json-object "message" "Something went wrong. Check that XAMPP MySQL is running and try again."))))))
