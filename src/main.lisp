(in-package :mend)
(defun main ()
  (initialize-database)
  (when (member "--demo" ext:*args* :test #'equal)
    (if (null (request-rows))
      (progn (db-query (read-text (merge-pathnames "db/demo.sql" *root*))) (format t "Sample requests loaded.~%"))
      (format t "Sample data skipped: the requests table already has records.~%")))
  (let ((server (socket:socket-server *port* :interface "127.0.0.1" :backlog 16)))
    (format t "~&Mend is ready: http://localhost:~D~%Database: ~A (XAMPP / MariaDB)~%Press Ctrl+C to stop.~%" *port* *database*)
    (finish-output)
    (unwind-protect
      (loop (with-open-stream (client (socket:socket-accept server :element-type '(unsigned-byte 8) :buffered t))
              (handle-client client)))
      (socket:socket-server-close server))))
