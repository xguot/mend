(defpackage :mend (:use :cl) (:export :main))
(in-package :mend)

(defparameter *root* (merge-pathnames "../" (make-pathname :name nil :type nil :defaults *load-truename*)))
(defun env (name default) (or (ext:getenv name) default))
(defparameter *database* (env "MEND_DB_NAME" "mend"))
(defparameter *port* (parse-integer (env "MEND_PORT" "4242")))
(defparameter *mysql* (env "MEND_MYSQL" "/Applications/XAMPP/xamppfiles/bin/mysql"))
(defparameter *socket* (env "MEND_DB_SOCKET" "/Applications/XAMPP/xamppfiles/var/mysql/mysql.sock"))
(defparameter *db-user* (env "MEND_DB_USER" "root"))
(defparameter *runtime* (merge-pathnames ".runtime/" *root*))

(defun utf8 (text) (ext:convert-string-to-bytes text charset:utf-8))
(defun from-utf8 (bytes) (ext:convert-string-from-bytes bytes charset:utf-8))
(defun read-text (path)
  (with-open-file (in path :external-format charset:utf-8)
    (with-output-to-string (out) (loop for c = (read-char in nil) while c do (write-char c out)))))
(defun split (text delimiter)
  (loop for start = 0 then (1+ end) for end = (position delimiter text :start start)
        collect (subseq text start end) while end))
(defun join (parts separator)
  (format nil "~{~A~}" (loop for part in parts for first = t then nil
                               append (if first (list part) (list separator part)))))
(defun random-token ()
  (with-open-file (in #P"/dev/urandom" :element-type '(unsigned-byte 8))
    (format nil "~(~{~2,'0X~}~)" (loop repeat 24 collect (read-byte in)))))
(defparameter *csrf-token* (random-token))
(defun json-string (value)
  (with-output-to-string (out)
    (write-char #\" out)
    (loop for c across (princ-to-string value) do
      (case c (#\" (write-string "\\\"" out)) (#\\ (write-string "\\\\" out))
        (#\Newline (write-string "\\n" out)) (#\Return (write-string "\\r" out))
        (#\Tab (write-string "\\t" out))
        (otherwise (if (< (char-code c) 32) (format out "\\u~4,'0X" (char-code c)) (write-char c out)))))
    (write-char #\" out)))
(defun json-object (&rest pairs)
  (concatenate 'string "{" (join (loop for (key value) on pairs by #'cddr
    collect (format nil "~A:~A" (json-string key) (json-string value))) ",") "}"))
(defun positive-id (text)
  (and text (plusp (length text)) (<= (length text) 10) (every #'digit-char-p text)
       (let ((id (parse-integer text))) (and (< 0 id 2147483648) id))))
(defun identifier-p (text)
  (and (<= 1 (length text) 64) (every (lambda (c) (or (find c "_abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"))) text)))
(defun decode-url (text)
  (let ((bytes (make-array 0 :element-type '(unsigned-byte 8) :adjustable t :fill-pointer 0)))
    (loop for i from 0 below (length text) for c = (char text i) do
      (cond ((char= c #\%)
             (unless (< (+ i 2) (length text)) (error "Invalid URL encoding."))
             (let ((a (digit-char-p (char text (1+ i)) 16)) (b (digit-char-p (char text (+ i 2)) 16)))
               (unless (and a b) (error "Invalid URL encoding."))
               (vector-push-extend (+ (* a 16) b) bytes) (incf i 2)))
            ((char= c #\+) (vector-push-extend 32 bytes))
            ((< (char-code c) 128) (vector-push-extend (char-code c) bytes))
            (t (error "URL values must be percent encoded."))))
    (from-utf8 bytes)))
(defun parse-form (body)
  (loop for pair in (split body #\&) for equals = (position #\= pair)
    collect (cons (decode-url (subseq pair 0 equals))
                  (if equals (decode-url (subseq pair (1+ equals))) ""))))
(defun field (form key) (string-trim '(#\Space #\Tab #\Newline #\Return) (or (cdr (assoc key form :test #'equal)) "")))
(defun valid-date-p (text)
  (and (= (length text) 10) (char= (char text 4) #\-) (char= (char text 7) #\-)
       (every #'digit-char-p (concatenate 'string (subseq text 0 4) (subseq text 5 7) (subseq text 8 10)))
       (let* ((year (parse-integer text :end 4)) (month (parse-integer text :start 5 :end 7))
              (day (parse-integer text :start 8))
              (leap (and (zerop (mod year 4)) (or (not (zerop (mod year 100))) (zerop (mod year 400))))))
         (and (<= 1900 year 9999) (<= 1 month 12)
              (<= 1 day (nth (1- month) (list 31 (if leap 29 28) 31 30 31 30 31 31 30 31 30 31)))))))
