# MEND_DB_USER is required; other variables are optional. Export these in your shell before ./start.sh.
# start.sh deliberately does not source .env files.
MEND_PORT=4242
MEND_DB_NAME=mend
MEND_DB_USER=
MEND_DB_PASSWORD=
MEND_MYSQL=/Applications/XAMPP/xamppfiles/bin/mysql
MEND_DB_SOCKET=/Applications/XAMPP/xamppfiles/var/mysql/mysql.sock
